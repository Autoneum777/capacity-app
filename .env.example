# Przykład zmiennych dla docker compose (skopiuj do `.env` i uzupełnij).
# Plik `.env` nie powinien trafiać do repozytorium.

PORT=3001
# Publiczny URL aplikacji (linki resetu hasła, Secure cookie).
# Na serwerze ustaw prawdziwy adres, np. https://capacity.firma.pl
# Nie zostawiaj localhost — migracja DB mogła wcześniej zapisać http://localhost:3001.
APP_BASE_URL=http://localhost:3001
# Opcjonalnie wymuś: 0 = zawsze bez Secure, 1 = zawsze Secure
# COOKIE_SECURE=0

AUTH_ENFORCE=1
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin12345
# Jednorazowo =1 aby zresetować hasło admina przy starcie (potem z powrotem 0)
# BOOTSTRAP_FORCE_ADMIN_PASSWORD=0

CAPACITY_DEPLOY_SECRET=change-me-capacity-deploy-secret

PASSWORD_RESET_TTL_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

CALCULATOR_CACHE=1
CALCULATOR_CACHE_TTL_MS=45000
AUTH_LEGACY_ACTOR=0
